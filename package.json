{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "source .env.local && supabase gen types typescript --project-id ${PROJECT_ID} --schema public > app/lib/database.types.ts",
    "db:types-local": "supabase gen types typescript --local > app/lib/database.types.ts",
    "db:seed": "PGPASSWORD=postgres psql -h localhost -p 54322 -U postgres -d postgres -f scripts/seed-dev-data.sql"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^7.13.2",
    "@mantine/form": "^7.13.2",
    "@mantine/hooks": "^7.13.2",
    "@mantine/notifications": "^7.13.4",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.84.1",
    "date-fns": "^3.6.0",
    "jotai": "^2.11.1",
    "next": "14.2.35",
    "react": "^18",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "jotai": "^2.0.0",
    "ws": "^8.20.1",
    "postcss": "^8.5.10",
    "cross-spawn": "^7.0.6",
    "picomatch": "^2.3.2",
    "flatted": "^3.4.0"
  }
